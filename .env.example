# Supabase project (dev locally / for `npm run dev`, prod on the Vercel Production env)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Server-only. Bypasses RLS — never expose to the client, never set NEXT_PUBLIC_ on it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# BOLT Bootcamp event UUID (differs between the dev and prod databases)
NEXT_PUBLIC_BOOTCAMP_EVENT_ID=2d144452-6cb2-44e3-8cf3-5af2ecf46058

# Base URL of this deployment (prod domain / staging branch URL / http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local-only TLS workaround — DO NOT set this in Vercel or any deployed environment.
# NODE_TLS_REJECT_UNAUTHORIZED=0
